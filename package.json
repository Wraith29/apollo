		"esbuild": "0.28.1",
		"eslint": "^10.4.0",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^17.6.0",
		"tslib": "2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.4"
	},
	"dependencies": {
		"date-fns": "^4.2.1",
		"mdast-util-from-markdown": "^2.0.3",
		"mdast-util-frontmatter": "^2.0.1",
